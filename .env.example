# LLM：默认使用 DeepSeek，也可切换 openai / openai_compatible / ollama / vllm / mock
APP_NAME=Enterprise RAG Agent
LLM_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# 旧配置兼容：OPENAI_API_KEY= 或 API_KEY=

# Embedding：DeepSeek 暂不提供公开 Embedding 接口，默认使用本地 hash；
# 如需语义向量，可指向其他 OpenAI 兼容 Embedding 服务。
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSION=256

# 向量库：json 可零依赖演示，chroma 用于生产
VECTOR_STORE_TYPE=json
VECTOR_STORE_PATH=data/vector_store

# 分块与检索
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=6
HYBRID_ALPHA=0.5
RERANK_ENABLED=true
RERANKER_MODEL=keyword

# Agent 约束
MAX_AGENT_STEPS=4
CONTEXT_MAX_TOKENS=4000
MAX_HISTORY_MESSAGES=12
SUMMARY_ENABLED=true
EVIDENCE_MIN_SCORE=0.01

# 服务
HOST=0.0.0.0
PORT=8000
